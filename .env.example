PORT=5000
DNS_SERVERS=1.1.1.1,8.8.8.8
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>
JWT_SECRET=change_this_to_a_long_random_secret

# Email verification for new customer and supplier accounts
RESEND_API_KEY=
RESEND_FROM_EMAIL=Somfuel <verify@your-verified-domain.com>

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
R2_REGION=auto
SUPPLIER_IMAGE_MAX_SIZE_MB=2

# Firebase Cloud Messaging (Android push notifications)..
# Path to the Firebase Admin SDK service-account JSON file (relative or absolute).
# Download from Firebase Console → Project settings → Service accounts → Generate new private key.
# Save the file to the path below and ensure the directory is in .gitignore (secrets/ is already ignored).
# Omit or leave blank to boot without push support — all approval flows still work normally.
FIREBASE_SERVICE_ACCOUNT=
